# ==============================================================
# METACITY — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================

# ── Supabase ───────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Redis (optional — simulation runs without it) ──────────────
REDIS_URL=redis://localhost:6379

# ── AI Providers (Phase 5 — not required for Phase 1) ─────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Simulation Config ──────────────────────────────────────────
SIMULATION_SEED=42
SIMULATION_CITY_SIZE=8000
SIMULATION_ACTIVE_CITIZENS=1000
SIMULATION_TICK_RATE=10
SIMULATION_CURRENCY=MC

# ── Server ─────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── Frontend (Vite — prefix with VITE_) ───────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
